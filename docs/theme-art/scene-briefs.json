  "canonicalLore": {
    "moon": "Good; dead and absent from current sky. Lunar relics and symbols are allowed.",
    "sun": "Evil; a sky-visible sun has an Oculum eye with golden-orange iris and dark pupil.",
    "stars": "Allied with the Moon.",
    "fairies": "Generally evil; never associate with Moon.",
    "devils": "Mostly lunar. A minority became power-mad after the Moon's death.",
    "castle": "Black Diabolical castle with a red moon symbol is a lunar ally.",
    "benedict": "Solar heroine exception and former ally of Moon. Only a cracked marble-and-gold protective statue remains, looking toward lower Lost Town.",
    "underground": "Closed continuous rock ceilings; no sky, sun, moon, clouds or surface openings.",
    "obser": "Cracked grey stone disc with engraved central almond eye; not generic decoration.",
    "elementalForest": "Fire trees, living green trees, frozen trees, crystals, earth and streams share a coherent forest."
  },
