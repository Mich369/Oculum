a decisione di scappare di nuovo, senza gufus non possono creare altro liquido anti asher, ma tails decise di rimanere per distruggere il macchinario in modo da far perdere anche quello che erano riusciti ad estrarre fino ad adesso, decisi di cedere a tails la pietra speciale datomi dallo strano essere lumaca, e iniziai a correre via con gufus in spalla.\nMentre correvo mi accorsi che il nuovo capo scienziato, ora diventato gigante grazie alla sostanza che si è inniettato, era in aria che precipitava verso il macchinario dove si trovava tails, subito dopo avvenne una grande esplosione, facendo a pezzi tails e lanciandolo verso la mia direzzione.","Mi svegliai nell'infermeria a postea,"],"fortuna":3,"partyMembri":[],"mostraSempreScudoOculum":false,"filtroExtraOcchio":"Tutti","difesaRapida":"0","hpTemp":"0","raccoltaOculumSpesa":0,"hpTempBonusConsumati":0,"feriteMorte":0,"mostraTastiRapidiIndice":true,"customDamageTypes":[],"raccoltaMateriaSpesa":0,"derivedDanno":33,"inventario":[{"nome":"insetti morti per criceto","peso":0.0,"quantita":190,"note":"","buff":"","arma":false,"protegge":false,"equipaggiata":false,"bonusDanno":0,"bonusDifesa":0,"bonusScudo":0,"gradoOggetto":0,"gradoRichiesto":0,"elementoDanno":"Fisico","putrefazioneSessioni":0,"sessioniSegnate":0,"putrefazioneGiornoInizio":1,"safeHpUsedDay":0,"saveShieldUsedDay":0},{"nome":"Pietra del nobile","peso":0.0,"quantita":1,"note":"","buff":"@stats+4","arma":false,"protegge":false,"equipaggiata":true,"bonusDanno":0,"bonusDifesa":0,"bonusScudo":0,"gradoOggetto":0,"gradoRichiesto":0,"elementoDanno":"Fisico","putrefazioneSessioni":0,"sessioniSegnate":0,"putrefazioneGiornoInizio":1,"safeHpUsedDay":0,"saveShieldUsedDay":0}],"secondaryColor":4278453531,"volontaVitale":0,"osservazionePuntiApplicati":false,"derivedMaxHp":130,"filtroTerziario":"Tutti","scudoOculumMax":"0","eyePupilGlowColor":4285234431,"enemyGradeExp":"0","ascensionDust":"1","campaignDifficultyStarterClaimed":false,"campaignDifficulty":"normale","grado":"