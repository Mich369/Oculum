i del manichino, e dopo sparando un fulmine che carbonizzÃ² tutti i manichini nelle vicinanze e facendo esplodere la testa di quello bersagliato.\nSubito dopo fummo chiamati dal capo il quale ci diede una missione, uccidere il bersaglio che stava creando caos.\nCi dirigemmo dall'obbiettivo, era un immortale, ma piu debole di quello che avevo affrontato, gli mancava il fattore rigenerante.\nFu un combattimento faticoso, sembrava che i miei colpi non lo scalfissero troppo, fino a che Sarah non gli sparo un colpo caricato, in grado di distruggergli il nucleo all'istante, facendo accasciare il bestione a terra, e facendogli fuoriuscire un cristallo corrotto, il quale ho distrutto all'istante prima che qualcuno venisse corrotto.\nRitornammo alla stazione, dove"],"fortuna":0,"partyMembri":[],"mostraSempreScudoOculum":false,"filtroExtraOcchio":"Tutti","difesaRapida":"0","hpTemp":"0","raccoltaOculumSpesa":11,"hpTempBonusConsumati":0,"feriteMorte":0,"mostraTastiRapidiIndice":true,"customDamageTypes":[],"raccoltaMateriaSpesa":0,"derivedDanno":46,"inventario":[{"nome":"Spadone gigante","peso":0.0,"quantita":1,"note":"","buff":"","arma":true,"protegge":false,"equipaggiata":true,"bonusDanno":25,"bonusDifesa":0,"bonusScudo":0,"elementoDanno":"Fisico","putrefazioneSessioni":0,"sessioniSegnate":0,"putrefazioneGiornoInizio":0,"safeHpUsedDay":0,"saveShieldUsedDay":0},{"nome":"safehp","peso":0.0,"quantita":1,"note":"","buff":"@safehp\n@saveShield+20","arma":false,"protegge":false,"equipaggiata":true,"bonusDanno":0,"bonusDifesa":0,"bonusScudo":0,"elementoDanno":"Fisico","putrefazioneSessioni":0,"sessioniSegnate":0,"putrefazioneGiornoInizio":1,"safeHpUsedDay":0,"saveShieldUsedDay":0}],"secondaryColor":4278652949,"volontaVitale":0,"osservazionePuntiApplicati":false,"derivedMaxHp":130,"filtroTerziario":"Tutti","scudoOculumMax":"0","eyePupilGlowColor":4294929290,"enemyGradeExp":"0","ascensionDust":"0","campaignDifficultyStarterClaimed":false,"campaignDifficulty":"facile","grado":"0","reput